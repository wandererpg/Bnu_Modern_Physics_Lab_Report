      {"id": "5", "latex": "\\tilde{L} = \\frac{eB}{4\\pi m_e c} = 0.467\\,B\\ (\\mathrm{cm^{-1}})", "description": "洛伦兹单位（B以T为单位）"},
      {"id": "6", "latex": "2d\\cos\\theta = K\\lambda", "description": "F-P标准具多光束干涉极大条件（d=2mm）"},
      {"id": "7", "latex": "F = \\frac{\\pi\\sqrt{R}}{1-R}", "description": "标准具精细度"},
      {"id": "10", "latex": "\\Delta\\tilde{\\nu} = \\frac{1}{2d}", "description": "自由光谱范围（色散范围）"},
      {"id": "13", "latex": "\\Delta D^2 = D_{K-1}^2 - D_K^2 = \\frac{4\\lambda f^2}{d}", "description": "相邻干涉序直径平方差（与K无关）"},
      {"id": "17", "latex": "\\tilde{\\nu}_b - \\tilde{\\nu}_a = \\frac{1}{2d}\\frac{D_a^2-D_b^2}{D_{K-1}^2-D_K^2}", "description": "由圆环直径平方差求谱线波数差"},
      {"id": "18", "latex": "\\frac{e}{m_e} = \\frac{2\\pi c}{(M_2g_2-M_1g_1)Bd}\\cdot\\frac{D_b^2-D_a^2}{D_{K-1}^2-D_K^2}", "description": "电子荷质比计算式"}
