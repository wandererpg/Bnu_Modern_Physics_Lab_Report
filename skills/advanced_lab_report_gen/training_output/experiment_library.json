  "光学多道与氢氘同位素光谱": {
    "domain": "原子物理/光谱学",
    "formulas": [
      {"id": "1", "latex": "\\varepsilon = h\\nu = E_2 - E_1, \\quad \\nu = (E_2-E_1)/h", "description": "原子跃迁光子能量与频率"},
      {"id": "2", "latex": "\\frac{1}{\\lambda_H} = R_H\\left(\\frac{1}{2^2} - \\frac{1}{n^2}\\right),\\ n=3,4,5,\\dots", "description": "氢原子巴尔末公式（本实验n=3-6）"},
      {"id": "3", "latex": "\\frac{1}{\\lambda_D} = R_D\\left(\\frac{1}{2^2} - \\frac{1}{n^2}\\right),\\ n=3,4,5,\\dots", "description": "氘原子巴尔末公式"},
      {"id": "4", "latex": "\\Delta\\lambda = \\lambda_H - \\lambda_D", "description": "氢氘同位素位移（谱线波长差）"},
      {"id": "5", "latex": "R_H = R_\\infty\\frac{m_p}{m_p+m_e}, \\quad R_D = R_\\infty\\frac{2m_p}{2m_p+m_e}", "description": "由核质量修正的里德堡常数"},
      {"id": "7", "latex": "\\frac{R_H - R_D}{R_D} \\approx \\frac{m_e}{2m_p}", "description": "里德堡常数相对差与电子质子质量比的关系"},
      {"id": "9", "latex": "\\frac{\\Delta\\lambda}{\\lambda_D} \\approx \\frac{m_e}{2m_p}", "description": "由同位素位移求电子质子质量比（m_p/m_e约1836）"},
      {"id": "R-附加", "latex": "n(\\lambda) = 1 + \\frac{n_g-1}{1+\\alpha t}, \\quad n_g = 1 + A + B/\\lambda^2 + C/\\lambda^4", "description": "报告用空气折射率修正（A=2876.04e-7, B=16.288e-7 µm^2, C=0.136e-7 µm^4）"}
    ],
    "data_methods": ["标准谱线定标（He/Ne灯线性定标）", "CCD多道光谱采集", "PMT单色扫描", "自动寻峰", "线性拟合求R_H", "空气折射率修正"],
    "constants": [
      {"name": "无穷大核质量里德堡常数R_∞", "value": "1.0973731e7", "unit": "m^-1"},
      {"name": "质子静止质量", "value": "1.6726485e-27", "unit": "kg"},
      {"name": "电子静止质量", "value": "9.109534e-31", "unit": "kg"},
      {"name": "实验理论值R_H", "value": "1.09678e7", "unit": "m^-1"},
      {"name": "H/D巴尔末谱线范围", "value": "410-656", "unit": "nm"}
    ],
    "variables": {
      "independent": {"name": "谱线位置（光栅角度/CCD像元）", "unit": "nm（定标后）"},
      "dependent": {"name": "光强/谱线波长λ、同位素位移Δλ", "unit": "a.u. / nm"}
    },
    "fit_model": "线性（定标）；巴尔末反比平方规律",
    "error_propagation": "由Δλ/λ_D = m_e/(2m_p) 推 m_p/m_e，误差主要来自Δλ测量与定标；R_H由斜率拟合给出（报告得相对误差约0.026%）"
  },
  "铷原子的光泵磁共振实验": {
    "domain": "原子物理（光抽运/磁共振）",
    "formulas": [
      {"id": "1", "latex": "\\mu_J = -g_J\\frac{e}{2m_e}P_J, \\quad g_J = 1 + \\frac{J(J+1)+S(S+1)-L(L+1)}{2J(J+1)}", "description": "电子总磁矩与朗德因子（L-S耦合）"},
      {"id": "2", "latex": "\\mu_F = -g_F\\frac{e}{2m_e}P_F, \\quad g_F = g_J\\frac{F(F+1)+J(J+1)-I(I+1)}{2F(F+1)}", "description": "计入核自旋后的超精细结构朗德因子"},
      {"id": "3", "latex": "E = E_0 + \\frac{ah}{2}[F(F+1)-I(I+1)-J(J+1)] + g_F\\mu_B B_0 m_F", "description": "弱磁场下超精细能级能量（a为磁偶极相互作用常数）"},
      {"id": "4", "latex": "\\Delta E_F = \\frac{ah}{2}[F'(F'+1)-F(F+1)]", "description": "基态两个超精细能级间隔（87Rb:F=1,2; 85Rb:F=2,3）"},
      {"id": "5", "latex": "\\Delta E_{m_F} = g_F\\mu_B B_0", "description": "相邻塞曼子能级间隔"},
      {"id": "8", "latex": "\\hbar\\omega_1 = g_F\\mu_B B_0", "description": "磁共振条件（光泵磁共振）"},
      {"id": "线圈", "latex": "B = \\frac{16\\pi N}{5^{3/2}r}I\\times10^{-3}\\ (\\mathrm{Gs}),\\ I\\ \\mathrm{in\\ A}", "description": "亥姆霍兹线圈电流-磁场换算（报告中使用）"}
    ],
    "data_methods": ["光抽运信号观察（方波扫场）", "扫场法磁共振（三角/锯齿波）", "换向法四组磁场组合求解g_F与地磁场", "取平均处理两组数据"],
    "constants": [
      {"name": "87Rb丰度", "value": "27.85", "unit": "%"},
      {"name": "85Rb丰度", "value": "72.15", "unit": "%"},
      {"name": "87Rb超精细常数a", "value": "3417.34", "unit": "MHz"},
      {"name": "85Rb超精细常数a", "value": "1011.9", "unit": "MHz"},
      {"name": "D1线波长", "value": "794.8", "unit": "nm"},
      {"name": "D2线波长", "value": "780.0", "unit": "nm"},
      {"name": "g_F理论值（87Rb,F=2）", "value": "0.5", "unit": ""},
      {"name": "g_F理论值（85Rb,F=3）", "value": "1/3", "unit": ""},
      {"name": "参考值f_1/B_0（87Rb）", "value": "0.70", "unit": "GHz/T"},
      {"name": "参考值f_1/B_0（85Rb）", "value": "4.667", "unit": "GHz/T"}
    ],
    "variables": {
      "independent": {"name": "外加水平/垂直磁场B0（线圈电流I）", "unit": "A → Gs"},
      "dependent": {"name": "透射光强（光抽运/磁共振信号）", "unit": "V（示波器）"}
    },
    "fit_model": "线性（共振频率-磁场比例）；无复杂拟合",
    "error_propagation": "g_F、B_e由四组方程组合平均求解；误差来自共振点定位（示波器判读）、扫场幅度与地磁场抵消不完全（报告中85Rb误差约6%，87Rb约0.5%）"
  },
  "塞曼效应": {
